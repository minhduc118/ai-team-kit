{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Session Summary",
  "type": "object",
  "required": ["id", "date", "author", "project", "goals"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "author": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "goals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": {
      "type": "string",
      "enum": ["completed", "in-progress", "blocked"]
    },
    "files_changed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
